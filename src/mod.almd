// wasm_bindgen — WASM + JS/TS binding generator for Almide.
//
// Library API (planned shape):
//   import wasm_bindgen
//   wasm_bindgen.version()                                 -> String
//   wasm_bindgen.generate_esm(iface_json, module_name)     -> String
//   wasm_bindgen.generate_dts(iface_json, module_name)     -> String
//   wasm_bindgen.generate_package_json(module, version)    -> String
//
// Reference implementation during port: almide-js/src/generate.mjs.
// Port order follows JS_TS_FRIENDLY_VISION.md P1 → P2 → P3.

import json

// ── Shared JSON helpers ──

fn get_str(v: Value, key: String) -> String =
  json.as_string(json.get(v, key) ?? json.from_string("")) ?? ""

fn get_arr(v: Value, key: String) -> List[Value] =
  json.as_array(json.get(v, key) ?? json.array([])) ?? []

fn get_kind(v: Value) -> String = get_str(v, "kind")

fn get_type(v: Value) -> Value = json.get(v, "type") ?? json.null()

// Render an Almide-style type expression (uses Capitalized names like
// `Int`, `List[Int]`, `Option[String]`, `Result[T, E]`, `Matrix`, named).
fn almide_type_str(ty: Value) -> String = match get_kind(ty) {
  "int"    => "Int",
  "float"  => "Float",
  "bool"   => "Bool",
  "string" => "String",
  "unit"   => "()",
  "matrix" => "Matrix",
  "list"   => "List[${almide_type_str(json.get(ty, "inner") ?? json.null())}]",
  "option" => "Option[${almide_type_str(json.get(ty, "inner") ?? json.null())}]",
  "result" => "Result[${almide_type_str(json.get(ty, "ok") ?? json.null())}, ${almide_type_str(json.get(ty, "err") ?? json.null())}]",
  "named"  => get_str(ty, "name"),
  _        => "Unknown",
}

// Render the Almide-style fn signature shown in JSDoc hover.
fn almide_fn_signature(fn_val: Value) -> String = {
  let name = get_str(fn_val, "name")
  let params = get_arr(fn_val, "params")
  let is_effect = json.as_bool(json.get(fn_val, "effect") ?? json.from_bool(false)) ?? false
  let kw = if is_effect then "effect fn" else "fn"
  let params_str = params
    |> list.map((p) => "${get_str(p, "name")}: ${almide_type_str(get_type(p))}")
    |> list.join(", ")
  let ret_str = almide_type_str(json.get(fn_val, "return") ?? json.null())
  "${kw} ${name}(${params_str}) -> ${ret_str}"
}

// Returns the effective return type used for JS-side marshalling.
//   - pure fn: just `return`
//   - effect fn: synthesizes `{kind: "result", ok: <return>, err: <error>}`
// This mirrors how the WASM ABI actually exports effect fns: the declared
// return type `T` is wrapped in a Result pointer so the caller can observe
// error propagation. On the JS surface it unwraps back to T via throw/return.
fn effective_return(fn_val: Value) -> Value = {
  let is_effect = json.as_bool(json.get(fn_val, "effect") ?? json.from_bool(false)) ?? false
  if is_effect then {
    let ok_ty = json.get(fn_val, "return") ?? json.null()
    let default_err = json.object([("kind", json.from_string("string"))])
    let err_ty = json.get(fn_val, "error") ?? default_err
    json.object([
      ("kind", json.from_string("result")),
      ("ok", ok_ty),
      ("err", err_ty),
    ])
  } else {
    json.get(fn_val, "return") ?? json.null()
  }
}

// Supported Almide Ty kinds for v0.1 (Int/Float/Bool/String/Unit).
// Returns true if the type has a direct JS/TS mapping at this stage.
fn is_supported_ty(ty: Value) -> Bool = match get_kind(ty) {
  "int"    => true,
  "float"  => true,
  "bool"   => true,
  "string" => true,
  "unit"   => true,
  "list"   => list_inner_supported(json.get(ty, "inner") ?? json.null()),
  "option" => option_inner_supported(json.get(ty, "inner") ?? json.null()),
  // v0.2 scope: Result is return-only. Params typed Result are a rare case
  // and are emitted with a /* unsupported */ stub in to_wasm if reached.
  "result" => result_supported(
    json.get(ty, "ok") ?? json.null(),
    json.get(ty, "err") ?? json.null()
  ),
  // Named refers to a user-defined record/variant. Trust that generate_esm /
  // generate_dts will emit helpers for it; field-level validation happens
  // when we walk iface.types[] and skip records with unsupported fields.
  "named"  => true,
  "matrix" => true,
  "tuple"  => tuple_supported(ty),
  "map"    => {
    let k = json.get(ty, "key") ?? json.null()
    let v = json.get(ty, "value") ?? json.null()
    map_key_supported(k) and map_value_supported(v)
  },
  "set"    => set_inner_supported(json.get(ty, "inner") ?? json.null()),
  "bytes"  => true,
  _        => false,
}

// Map keys in v0.x: primitives + String. Almide's WASM map uses type-aware
// equality (i64_eq, i32_eq, string.eq) on the key — we marshal primitives by
// value and String by ptr, matching those comparators exactly.
fn map_key_supported(k: Value) -> Bool = match get_kind(k) {
  "int" => true, "float" => true, "bool" => true, "string" => true,
  _ => false,
}

// Map values can be any supported type whose WASM slot is either an inline
// primitive (8-byte Int / 8-byte Float / 4-byte Bool) or a 4-byte pointer
// (String / Named / List / Option / Matrix / Bytes). Compound inner types
// delegate to is_supported_ty for recursive validation.
fn map_value_supported(v: Value) -> Bool = match get_kind(v) {
  "int" => true, "float" => true, "bool" => true, "string" => true,
  "named"  => true,
  "matrix" => true,
  "bytes"  => true,
  "list"   => is_supported_ty(v),
  "option" => is_supported_ty(v),
  _ => false,
}

fn set_inner_supported(e: Value) -> Bool = match get_kind(e) {
  "int" => true, "float" => true, "bool" => true, "string" => true,
  "named"  => true,
  "bytes"  => true,
  _ => false,
}

// Signature per type (used in tuple/map/set helper names). Encodes nested
// compound types so `Map[String, List[Int]]` and `Map[String, List[Float]]`
// get distinct helpers (`_writeMap_S_LI` vs `_writeMap_S_LF`).
fn type_sig(ty: Value) -> String = match get_kind(ty) {
  "int"    => "I",
  "float"  => "F",
  "bool"   => "B",
  "string" => "S",
  "named"  => "N${get_str(ty, "name")}",
  "list"   => "L${type_sig(json.get(ty, "inner") ?? json.null())}",
  "option" => "O${type_sig(json.get(ty, "inner") ?? json.null())}",
  "matrix" => "M",
  "bytes"  => "Y",
  _        => "X",
}

// Legacy alias — kept for the tuple helper (which only takes primitive / named
// elements). Deprecated in favor of type_sig.
fn prim_sig(ty: Value) -> String = type_sig(ty)

// Tuple with primitive / string / named elements. Nested tuple/list/option
// deferred to a later iter.
fn tuple_supported(ty: Value) -> Bool = {
  let elems = get_arr(ty, "elements")
  elems |> list.fold(true, (acc, e) => acc and match get_kind(e) {
    "int" => true, "float" => true, "bool" => true, "string" => true,
    "named" => true, "matrix" => true, "bytes" => true,
    _ => false,
  })
}

// Deterministic signature for a tuple type, used to name emitted helpers
// (one _writeTuple_<sig> / _readTuple_<sig> per unique element list).
fn tuple_sig(ty: Value) -> String = {
  let elems = get_arr(ty, "elements")
  elems |> list.map((e) => match get_kind(e) {
    "int"    => "I",
    "float"  => "F",
    "bool"   => "B",
    "string" => "S",
    "matrix" => "M",
    "named"  => "N${get_str(e, "name")}",
    _        => "X",
  }) |> list.join("")
}

// Inline-value fields (stored by direct load/store in the record body).
// Pointer-typed fields go through to_wasm / from_wasm with an extra
// i32 pointer slot in the record.
fn record_field_is_inline(ty: Value) -> Bool = match get_kind(ty) {
  "int"   => true,
  "float" => true,
  "bool"  => true,
  _       => false,
}

// True when the field of a record can be marshalled under v0.2+ scope.
// Primitives are stored inline, pointer-typed fields (string / named /
// matrix / list / option) are stored as i32 pointers and dispatched via
// to_wasm / from_wasm recursively.
fn record_field_ty_supported(ty: Value) -> Bool = match get_kind(ty) {
  "int"    => true,
  "float"  => true,
  "bool"   => true,
  "string" => true,
  "named"  => true,
  "matrix" => true,
  "list"   => list_inner_supported(json.get(ty, "inner") ?? json.null()),
  "option" => option_inner_supported(json.get(ty, "inner") ?? json.null()),
  _        => false,
}

// v0.2: List is supported when the element type is a primitive Almide Int.
// Extend to float/bool/string later. Matrix[T] gets its own type (Ty::Matrix),
// not list, so no conflict.
fn list_inner_supported(inner: Value) -> Bool = match get_kind(inner) {
  "int"    => true,
  "float"  => true,
  "bool"   => true,
  "string" => true,
  // Pointer-shaped inner types: delegate to is_supported_ty (mutual recursion
  // with option_inner_supported / etc). Named is trusted.
  "option" => is_supported_ty(inner),
  "named"  => true,
  "list"   => is_supported_ty(inner),
  _        => false,
}

fn option_inner_supported(inner: Value) -> Bool = match get_kind(inner) {
  "int"    => true,
  "float"  => true,
  "bool"   => true,
  "string" => true,
  _        => false,
}

fn result_supported(ok_ty: Value, err_ty: Value) -> Bool =
  if get_kind(err_ty) != "string" then false
  else match get_kind(ok_ty) {
    "int"    => true,
    "float"  => true,
    "bool"   => true,
    "string" => true,
    "unit"   => true,
    _        => false,
  }

// A function is eligible for export if:
//  - it is not `main` (that is the _start entry)
//  - every param type is supported
//  - the return type is supported
fn is_supported_fn(fn_val: Value) -> Bool = {
  let name = get_str(fn_val, "name")
  if name == "main" then false
  else {
    let ret_ok = is_supported_ty(effective_return(fn_val))
    let params = get_arr(fn_val, "params")
    let params_ok = params |> list.fold(true, (acc, p) => acc and is_supported_ty(get_type(p)))
    ret_ok and params_ok
  }
}

// ── Ty → TypeScript type ──

fn ts_type(ty: Value) -> String = match get_kind(ty) {
  "int"    => "number",
  "float"  => "number",
  "bool"   => "boolean",
  "string" => "string",
  "unit"   => "void",
  "list"   => {
    let inner = ts_type(json.get(ty, "inner") ?? json.null())
    // Parenthesize union / intersection inners so `T | null` inside a list
    // becomes `(T | null)[]` not `T | null[]`.
    if string.contains(inner, " ") then "(${inner})[]" else "${inner}[]"
  },
  "option" => "${ts_type(json.get(ty, "inner") ?? json.null())} | null",
  // Result[T, E] → T on JS surface (Err is thrown, so the static type is T).
  "result" => ts_type(json.get(ty, "ok") ?? json.null()),
  // Named record/variant → use the type name directly. TS interface is
  // emitted separately at the top of the .d.ts from iface.types[].
  "named"  => get_str(ty, "name"),
  // Matrix is always f64 at the WASM ABI level; JS surface is a named
  // `Matrix` interface that wraps Float64Array data (zero-copy).
  "matrix" => "Matrix",
  // Tuples map to TS tuple literals: `[T1, T2, T3]`. Always bracketed.
  "tuple" => {
    let elems = get_arr(ty, "elements")
    let parts = elems |> list.map((e) => ts_type(e)) |> list.join(", ")
    "[${parts}]"
  },
  "map" => {
    let k = ts_type(json.get(ty, "key") ?? json.null())
    let v = ts_type(json.get(ty, "value") ?? json.null())
    "Map<${k}, ${v}>"
  },
  "set" => "Set<${ts_type(json.get(ty, "inner") ?? json.null())}>",
  "bytes" => "Uint8Array",
  _        => "unknown",
}

// ── Ty → JS marshalling expression (to_wasm / from_wasm) ──
// {EXPR} is a literal placeholder that the emitter replaces with the
// actual sub-expression at codegen time.

fn to_wasm(ty: Value, expr: String) -> String = match get_kind(ty) {
  "int"    => "BigInt(${expr})",
  "float"  => expr,
  "bool"   => "(${expr} ? 1 : 0)",
  "string" => "_writeString(${expr})",
  "unit"   => "",
  "list"   => list_to_wasm(json.get(ty, "inner") ?? json.null(), expr),
  "option" => option_to_wasm(json.get(ty, "inner") ?? json.null(), expr),
  "named"  => "_write${get_str(ty, "name")}(${expr})",
  "matrix" => "_writeMatrix(${expr})",
  "tuple"  => "_writeTuple_${tuple_sig(ty)}(${expr})",
  "map"    => {
    let k = json.get(ty, "key") ?? json.null()
    let v = json.get(ty, "value") ?? json.null()
    "_writeMap_${type_sig(k)}_${type_sig(v)}(${expr})"
  },
  "set"    => "_writeSet_${type_sig(json.get(ty, "inner") ?? json.null())}(${expr})",
  "bytes"  => "_writeBytes(${expr})",
  _        => expr,
}

fn from_wasm(ty: Value, expr: String) -> String = match get_kind(ty) {
  "int"    => "Number(${expr})",
  "float"  => expr,
  "bool"   => "(${expr} !== 0)",
  "string" => "_readString(${expr})",
  "unit"   => "undefined",
  "list"   => list_from_wasm(json.get(ty, "inner") ?? json.null(), expr),
  "option" => option_from_wasm(json.get(ty, "inner") ?? json.null(), expr),
  "result" => result_from_wasm(
    json.get(ty, "ok") ?? json.null(),
    json.get(ty, "err") ?? json.null(),
    expr
  ),
  "named"  => "_read${get_str(ty, "name")}(${expr})",
  "matrix" => "_readMatrix(${expr})",
  "tuple"  => "_readTuple_${tuple_sig(ty)}(${expr})",
  "map"    => {
    let k = json.get(ty, "key") ?? json.null()
    let v = json.get(ty, "value") ?? json.null()
    "_readMap_${type_sig(k)}_${type_sig(v)}(${expr})"
  },
  "set"    => "_readSet_${type_sig(json.get(ty, "inner") ?? json.null())}(${expr})",
  "bytes"  => "_readBytes(${expr})",
  _        => expr,
}

// List marshalling dispatch on the element type.
// Layout: ptr → [len:i32 LE][elem * len] (elem size = byte_size(inner)).
// List marshalling. Primitive inner types have specialized helpers with
// their own per-slot byte size and setter/getter. Pointer-shaped inner
// types (Option, named record, nested List) go through generic _writeListPtr /
// _readListPtr, which stores one i32 pointer per slot and delegates
// marshalling to the recursively-dispatched to_wasm / from_wasm expression.
fn list_to_wasm(inner: Value, expr: String) -> String = match get_kind(inner) {
  "int"    => "_writeListInt(${expr})",
  "float"  => "_writeListFloat(${expr})",
  "bool"   => "_writeListBool(${expr})",
  "string" => "_writeListString(${expr})",
  "option" => "_writeListPtr(${expr}, (v) => ${to_wasm(inner, "v")})",
  "named"  => "_writeListPtr(${expr}, (v) => ${to_wasm(inner, "v")})",
  "list"   => "_writeListPtr(${expr}, (v) => ${to_wasm(inner, "v")})",
  _        => "/* unsupported List[${get_kind(inner)}] */${expr}",
}

fn list_from_wasm(inner: Value, expr: String) -> String = match get_kind(inner) {
  "int"    => "_readListInt(${expr})",
  "float"  => "_readListFloat(${expr})",
  "bool"   => "_readListBool(${expr})",
  "string" => "_readListString(${expr})",
  "option" => "_readListPtr(${expr}, (p) => ${from_wasm(inner, "p")})",
  "named"  => "_readListPtr(${expr}, (p) => ${from_wasm(inner, "p")})",
  "list"   => "_readListPtr(${expr}, (p) => ${from_wasm(inner, "p")})",
  _        => "/* unsupported List[${get_kind(inner)}] */${expr}",
}

// Option marshalling — Almide ABI: ptr = 0 means None, non-zero ptr means
// Some(v) and points to an inline [value] block (no tag, no length prefix).
fn option_to_wasm(inner: Value, expr: String) -> String = match get_kind(inner) {
  "int"    => "_writeOptionInt(${expr})",
  "float"  => "_writeOptionFloat(${expr})",
  "bool"   => "_writeOptionBool(${expr})",
  "string" => "_writeOptionString(${expr})",
  _        => "/* unsupported Option[${get_kind(inner)}] */${expr}",
}

fn option_from_wasm(inner: Value, expr: String) -> String = match get_kind(inner) {
  "int"    => "_readOptionInt(${expr})",
  "float"  => "_readOptionFloat(${expr})",
  "bool"   => "_readOptionBool(${expr})",
  "string" => "_readOptionString(${expr})",
  _        => "/* unsupported Option[${get_kind(inner)}] */${expr}",
}

// Result marshalling — Almide ABI: ptr → [tag:i32][value], tag=0 ok, tag=1 err.
// JS surface: Ok(v) → return v, Err(e) → throw new Error(e as string).
// v0.2 scope: Err type must be String (most common case; effect fn also uses this).
fn result_from_wasm(ok_ty: Value, err_ty: Value, expr: String) -> String =
  if get_kind(err_ty) == "string" then
    match get_kind(ok_ty) {
      "int"    => "_readResultIntString(${expr})",
      "float"  => "_readResultFloatString(${expr})",
      "bool"   => "_readResultBoolString(${expr})",
      "string" => "_readResultStringString(${expr})",
      "unit"   => "_readResultUnitString(${expr})",
      _        => "/* unsupported Result[${get_kind(ok_ty)}, String] */${expr}",
    }
  else "/* unsupported Result[_, ${get_kind(err_ty)}] */${expr}"

// ── Record helpers ──
//
// Each record type yields one `_write<Name>` and one `_read<Name>` JS helper.
// Layout matches almide's emit_wasm: fields are packed sequentially in order
// at offsets declared in iface.types[i].abi.fields[j].offset.

// WASM-layout byte size for a primitive field type. **Not** the same as
// iface.types[].abi.fields[].size, which reflects the Rust repr-c ABI used
// by the native FFI target. The WASM emit in almide uses:
//   Int    → 8 (i64)
//   Float  → 8 (f64)
//   Bool   → 4 (i32)
//   String → 4 (i32 pointer)
//   (other heap types) → 4 (i32 pointer)
fn wasm_byte_size(ty: Value) -> Int = match get_kind(ty) {
  "int"    => 8,
  "float"  => 8,
  "bool"   => 4,
  "string" => 4,
  _        => 4,
}

// Sum of wasm_byte_size over all fields. Matches almide's emit_wasm::values::record_size.
fn wasm_record_size(fields: List[Value]) -> Int =
  fields |> list.fold(0, (acc, f) => acc + wasm_byte_size(get_type(f)))

// Running offsets for each field in WASM layout.
fn wasm_record_offsets(fields: List[Value]) -> List[Int] = {
  let pair = fields |> list.fold(([], 0), (state, f) => {
    let (acc, off) = state
    (acc + [off], off + wasm_byte_size(get_type(f)))
  })
  match pair { (offsets, _) => offsets }
}

// Collect all Named type names transitively referenced by a Ty node
// (recursively into list.inner, option.inner, result.ok, result.err, and
// record fields). Used to filter iface.types[] down to just the records
// the user's functions actually expose, keeping stdlib records
// (FileStat, ProcessStatus, ...) out of the generated .d.ts.
fn collect_named_in_ty(ty: Value) -> List[String] = match get_kind(ty) {
  "named"  => [get_str(ty, "name")],
  "list"   => collect_named_in_ty(json.get(ty, "inner") ?? json.null()),
  "option" => collect_named_in_ty(json.get(ty, "inner") ?? json.null()),
  "result" => {
    let ok_names = collect_named_in_ty(json.get(ty, "ok") ?? json.null())
    let err_names = collect_named_in_ty(json.get(ty, "err") ?? json.null())
    ok_names + err_names
  },
  "tuple" => {
    let elems = get_arr(ty, "elements")
    elems |> list.flat_map((e) => collect_named_in_ty(e))
  },
  _        => [],
}

// Walk a function's param + return types and collect every tuple type that
// appears. The tuples are returned as-is (Value) so emit_tuple_helpers can
// read `elements`. Dedup by `tuple_sig` at the caller.
fn collect_tuples_in_ty(ty: Value) -> List[Value] = match get_kind(ty) {
  "tuple"  => [ty],
  "list"   => collect_tuples_in_ty(json.get(ty, "inner") ?? json.null()),
  "option" => collect_tuples_in_ty(json.get(ty, "inner") ?? json.null()),
  "result" => {
    let ok_ts = collect_tuples_in_ty(json.get(ty, "ok") ?? json.null())
    let err_ts = collect_tuples_in_ty(json.get(ty, "err") ?? json.null())
    ok_ts + err_ts
  },
  _ => [],
}

fn collect_tuples_in_fn(fn_val: Value) -> List[Value] = {
  let params = get_arr(fn_val, "params")
  let param_tuples = params |> list.flat_map((p) => collect_tuples_in_ty(get_type(p)))
  let ret_tuples = collect_tuples_in_ty(effective_return(fn_val))
  param_tuples + ret_tuples
}

// Does this type use `Matrix`? Walks compound types recursively.
fn ty_uses_matrix(ty: Value) -> Bool = match get_kind(ty) {
  "matrix" => true,
  "list"   => ty_uses_matrix(json.get(ty, "inner") ?? json.null()),
  "option" => ty_uses_matrix(json.get(ty, "inner") ?? json.null()),
  "result" => {
    let ok_ty = json.get(ty, "ok") ?? json.null()
    let err_ty = json.get(ty, "err") ?? json.null()
    ty_uses_matrix(ok_ty) or ty_uses_matrix(err_ty)
  },
  "map" => ty_uses_matrix(json.get(ty, "value") ?? json.null()),
  "set" => ty_uses_matrix(json.get(ty, "inner") ?? json.null()),
  "tuple" => {
    let elems = get_arr(ty, "elements")
    elems |> list.fold(false, (acc, e) => acc or ty_uses_matrix(e))
  },
  _        => false,
}

// Does Bytes appear anywhere in the type tree? Used to decide whether the
// fixed _writeBytes/_readBytes helper pair needs emitting.
fn bytes_appears_in(ty: Value) -> Bool = match get_kind(ty) {
  "bytes"  => true,
  "list"   => bytes_appears_in(json.get(ty, "inner") ?? json.null()),
  "option" => bytes_appears_in(json.get(ty, "inner") ?? json.null()),
  "result" => bytes_appears_in(json.get(ty, "ok") ?? json.null())
              or bytes_appears_in(json.get(ty, "err") ?? json.null()),
  "map"    => bytes_appears_in(json.get(ty, "value") ?? json.null()),
  "set"    => bytes_appears_in(json.get(ty, "inner") ?? json.null()),
  "tuple"  => {
    let elems = get_arr(ty, "elements")
    elems |> list.fold(false, (acc, e) => acc or bytes_appears_in(e))
  },
  _        => false,
}

fn fn_uses_matrix(fn_val: Value) -> Bool = {
  let params = get_arr(fn_val, "params")
  let any_param = params |> list.fold(false, (acc, p) => acc or ty_uses_matrix(get_type(p)))
  any_param or ty_uses_matrix(effective_return(fn_val))
}

fn collect_named_in_fn(fn_val: Value) -> List[String] = {
  let params = get_arr(fn_val, "params")
  let param_names = params |> list.flat_map((p) => collect_named_in_ty(get_type(p)))
  let ret_names = collect_named_in_ty(effective_return(fn_val))
  param_names + ret_names
}

// Expand names to include fields' named types (for nested records like Foo
// containing a Bar field). Not yet supported by the record helpers but we
// include them in the interface list so the TS compiler can resolve them.
fn expand_named_deps(names: List[String], types: List[Value]) -> List[String] = {
  names |> list.flat_map((name) => {
    let def = types |> list.find((t) => get_str(t, "name") == name)
    match def {
      some(d) => {
        let kind_rec = json.get(d, "kind") ?? json.null()
        let fields = get_arr(kind_rec, "fields")
        let inner = fields |> list.flat_map((f) => collect_named_in_ty(get_type(f)))
        [name] + inner
      },
      none => [name],
    }
  })
}

// ── Variant helpers ──
//
// WASM ABI: variant values are i32 pointers to `[tag:i32][payload...]`.
// Total alloc is max across all cases (so any value of the type fits).
// Per-case payload = concatenated fields of the case's tuple, sequential
// offsets starting at 4.
//
// JS surface: discriminated union `{ tag: 'CaseName', _0: T0, _1: T1, ... }`
// with unit cases carrying just `{ tag: 'CaseName' }`.

fn variant_case_fields(case_def: Value) -> List[Value] = {
  let payload = json.get(case_def, "payload") ?? json.null()
  if get_kind(payload) == "tuple" then get_arr(payload, "fields") else []
}

// WASM bytes needed for one case: 4 (tag) + sum of field sizes.
fn variant_case_size(case_def: Value) -> Int = {
  let fields = variant_case_fields(case_def)
  4 + (fields |> list.fold(0, (acc, f) => acc + wasm_byte_size(f)))
}

// Variant allocation size = max across all cases.
fn variant_alloc_size(cases: List[Value]) -> Int =
  cases |> list.fold(4, (acc, c) => {
    let sz = variant_case_size(c)
    if sz > acc then sz else acc
  })

// Predicate: all payload fields of all cases are primitives.
fn variant_case_fields_supported(case_def: Value) -> Bool = {
  let fields = variant_case_fields(case_def)
  fields |> list.fold(true, (acc, f) => acc and record_field_ty_supported(f))
}

fn variant_supported(type_def: Value) -> Bool = {
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  if get_kind(kind_rec) != "variant" then false
  else {
    let cases = get_arr(kind_rec, "cases")
    cases |> list.fold(true, (acc, c) => acc and variant_case_fields_supported(c))
  }
}

// Emit a TS discriminated union declaration.
fn emit_variant_type(type_def: Value) -> List[String] = {
  let name = get_str(type_def, "name")
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  let cases = get_arr(kind_rec, "cases")
  let case_lines = cases |> list.map((c) => {
    let cname = get_str(c, "name")
    let fields = variant_case_fields(c)
    if list.is_empty(fields) then
      "  | { tag: \"${cname}\" }"
    else {
      let field_strs = fields |> list.enumerate |> list.map((entry) => {
        let (i, f) = entry
        "_${int.to_string(i)}: ${ts_type(f)}"
      })
      "  | { tag: \"${cname}\"; ${field_strs |> list.join("; ")} }"
    }
  })
  ["export type ${name} ="] + case_lines + [";", ""]
}

// Emit JS `_writeX` / `_readX` for a variant type.
fn emit_variant_helpers(type_def: Value) -> List[String] = {
  let name = get_str(type_def, "name")
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  let cases = get_arr(kind_rec, "cases")
  let size = int.to_string(variant_alloc_size(cases))

  // Write branches
  let write_branches = cases |> list.enumerate |> list.flat_map((entry) => {
    let (tag, c) = entry
    let cname = get_str(c, "name")
    let fields = variant_case_fields(c)
    let header = [
      "  if (obj.tag === \"${cname}\") {",
      "    view.setInt32(ptr, ${int.to_string(tag)}, true);",
    ]
    let pre_lines = fields |> list.enumerate |> list.flat_map((fe) => {
      let (i, f) = fe
      if get_kind(f) == "string" then
        ["    const _p${int.to_string(i)} = _writeString(obj._${int.to_string(i)});"]
      else []
    })
    let field_stores = fields |> list.enumerate |> list.fold(([], 4), (state, fe) => {
      let (acc, off) = state
      let (i, f) = fe
      let off_s = int.to_string(off)
      let store = match get_kind(f) {
        "int"    => "    view.setBigInt64(ptr + ${off_s}, BigInt(obj._${int.to_string(i)}), true);",
        "float"  => "    view.setFloat64(ptr + ${off_s}, obj._${int.to_string(i)}, true);",
        "bool"   => "    view.setInt32(ptr + ${off_s}, obj._${int.to_string(i)} ? 1 : 0, true);",
        "string" => "    view.setInt32(ptr + ${off_s}, _p${int.to_string(i)}, true);",
        _        => "    /* unsupported payload */",
      }
      (acc + [store], off + wasm_byte_size(f))
    })
    let store_lines = match field_stores { (lines, _) => lines }
    let footer = ["    return ptr;", "  }"]
    header + pre_lines + store_lines + footer
  })

  let read_branches = cases |> list.enumerate |> list.flat_map((entry) => {
    let (tag, c) = entry
    let cname = get_str(c, "name")
    let fields = variant_case_fields(c)
    if list.is_empty(fields) then [
      "    case ${int.to_string(tag)}: return { tag: \"${cname}\" };",
    ]
    else {
      let field_reads = fields |> list.enumerate |> list.fold(([], 4), (state, fe) => {
        let (acc, off) = state
        let (i, f) = fe
        let off_s = int.to_string(off)
        let read = match get_kind(f) {
          "int"    => "_${int.to_string(i)}: Number(view.getBigInt64(ptr + ${off_s}, true))",
          "float"  => "_${int.to_string(i)}: view.getFloat64(ptr + ${off_s}, true)",
          "bool"   => "_${int.to_string(i)}: view.getInt32(ptr + ${off_s}, true) !== 0",
          "string" => "_${int.to_string(i)}: _readString(view.getInt32(ptr + ${off_s}, true))",
          _        => "_${int.to_string(i)}: undefined",
        }
        (acc + [read], off + wasm_byte_size(f))
      })
      let read_lines = match field_reads { (lines, _) => lines }
      [
        "    case ${int.to_string(tag)}: return { tag: \"${cname}\", ${read_lines |> list.join(", ")} };",
      ]
    }
  })

  let write_block = [
    "function _write${name}(obj) {",
    "  const ptr = _exports.__alloc(${size});",
    "  const view = new DataView(_exports.memory.buffer);",
  ] + write_branches + [
    "  throw new Error(\"Unknown ${name} tag: \" + obj.tag);",
    "}",
    "",
  ]

  let read_block = [
    "function _read${name}(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  const tag = view.getInt32(ptr, true);",
    "  switch (tag) {",
  ] + read_branches + [
    "    default: throw new Error(\"Unknown ${name} tag: \" + tag);",
    "  }",
    "}",
    "",
  ]

  write_block + read_block
}

// Predicate: is this Record fully marshallable under v0.2 scope?
fn record_supported(type_def: Value) -> Bool = {
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  if get_kind(kind_rec) != "record" then false
  else {
    let fields = get_arr(kind_rec, "fields")
    fields |> list.fold(true, (acc, f) => acc and record_field_ty_supported(get_type(f)))
  }
}

// Emit `_write<Name>` + `_read<Name>` JS helpers for a record type.
// Returns a List[String] of lines to be included in generate_esm's preamble.
//
// Layout mirrors emit_wasm: fields packed sequentially; offsets come from
// iface.types[i].abi.fields[j].offset. String fields are written first
// (before outer __alloc) so memory grow does not invalidate in-flight writes.
fn emit_record_helpers(type_def: Value) -> List[String] = {
  let name = get_str(type_def, "name")
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  let fields = get_arr(kind_rec, "fields")
  // NOTE: iface.types[].abi is the Rust repr-c layout (for the native FFI
  // target) and does NOT match WASM layout. We compute our own offsets using
  // wasm_byte_size, which matches almide's emit_wasm::values::byte_size.
  let size = int.to_string(wasm_record_size(fields))
  let offsets = wasm_record_offsets(fields)

  // Pre-compute pointer-typed fields before the outer __alloc so memory
  // growth during nested writes does not corrupt the outer write phase.
  // Inline-value fields (int/float/bool) are written directly into the
  // allocated record buffer.
  let pre_lines = fields |> list.enumerate |> list.flat_map((entry) => {
    let (i, f) = entry
    let ty = get_type(f)
    let fname = get_str(f, "name")
    if record_field_is_inline(ty) then []
    else ["  const _f${int.to_string(i)} = ${to_wasm(ty, "obj.${fname}")};"]
  })

  let store_lines = fields |> list.enumerate |> list.map((entry) => {
    let (i, f) = entry
    let fname = get_str(f, "name")
    let ty = get_type(f)
    let off = int.to_string(list.get(offsets, i) ?? 0)
    match get_kind(ty) {
      "int"    => "  view.setBigInt64(ptr + ${off}, BigInt(obj.${fname}), true);",
      "float"  => "  view.setFloat64(ptr + ${off}, obj.${fname}, true);",
      "bool"   => "  view.setInt32(ptr + ${off}, obj.${fname} ? 1 : 0, true);",
      _        => "  view.setInt32(ptr + ${off}, _f${int.to_string(i)}, true);",
    }
  })

  let read_lines = fields |> list.enumerate |> list.map((entry) => {
    let (i, f) = entry
    let fname = get_str(f, "name")
    let ty = get_type(f)
    let off = int.to_string(list.get(offsets, i) ?? 0)
    match get_kind(ty) {
      "int"    => "    ${fname}: Number(view.getBigInt64(ptr + ${off}, true)),",
      "float"  => "    ${fname}: view.getFloat64(ptr + ${off}, true),",
      "bool"   => "    ${fname}: view.getInt32(ptr + ${off}, true) !== 0,",
      _        => "    ${fname}: ${from_wasm(ty, "view.getInt32(ptr + ${off}, true)")},",
    }
  })

  let write_block = [
    "function _write${name}(obj) {",
  ] + pre_lines + [
    "  const ptr = _exports.__alloc(${size});",
    "  const view = new DataView(_exports.memory.buffer);",
  ] + store_lines + [
    "  return ptr;",
    "}",
    "",
  ]

  let read_block = [
    "function _read${name}(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  return {",
  ] + read_lines + [
    "  };",
    "}",
    "",
  ]

  write_block + read_block
}

// Emit _writeTuple_<sig> / _readTuple_<sig> helpers for a tuple type.
// Layout (matches emit_wasm/collections.rs): elements packed sequentially,
// offset[i] = sum of wasm_byte_size(elements[0..i]).
fn emit_tuple_helpers(ty: Value) -> List[String] = {
  let sig = tuple_sig(ty)
  let elems = get_arr(ty, "elements")
  let size = int.to_string(elems |> list.fold(0, (acc, e) => acc + wasm_byte_size(e)))
  let offsets = {
    let (acc, _) = elems |> list.fold(([], 0), (state, e) => {
      let (os, off) = state
      (os + [off], off + wasm_byte_size(e))
    })
    acc
  }

  // Pre-compute ptr-shaped element marshalling before outer __alloc to
  // avoid growth mid-write invalidating views.
  let pre_lines = elems |> list.enumerate |> list.flat_map((entry) => {
    let (i, e) = entry
    let is_inline = match get_kind(e) {
      "int" => true, "float" => true, "bool" => true, _ => false
    }
    if is_inline then []
    else ["  const _t${int.to_string(i)} = ${to_wasm(e, "arr[${int.to_string(i)}]")};"]
  })

  let store_lines = elems |> list.enumerate |> list.map((entry) => {
    let (i, e) = entry
    let off = int.to_string(list.get(offsets, i) ?? 0)
    let idx = int.to_string(i)
    match get_kind(e) {
      "int"   => "  view.setBigInt64(ptr + ${off}, BigInt(arr[${idx}]), true);",
      "float" => "  view.setFloat64(ptr + ${off}, arr[${idx}], true);",
      "bool"  => "  view.setInt32(ptr + ${off}, arr[${idx}] ? 1 : 0, true);",
      _       => "  view.setInt32(ptr + ${off}, _t${idx}, true);",
    }
  })

  let read_lines = elems |> list.enumerate |> list.map((entry) => {
    let (i, e) = entry
    let off = int.to_string(list.get(offsets, i) ?? 0)
    match get_kind(e) {
      "int"   => "    Number(view.getBigInt64(ptr + ${off}, true)),",
      "float" => "    view.getFloat64(ptr + ${off}, true),",
      "bool"  => "    view.getInt32(ptr + ${off}, true) !== 0,",
      _       => "    ${from_wasm(e, "view.getInt32(ptr + ${off}, true)")},",
    }
  })

  let write_block = [
    "function _writeTuple_${sig}(arr) {",
  ] + pre_lines + [
    "  const ptr = _exports.__alloc(${size});",
    "  const view = new DataView(_exports.memory.buffer);",
  ] + store_lines + [
    "  return ptr;",
    "}",
    "",
  ]

  let read_block = [
    "function _readTuple_${sig}(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  return [",
  ] + read_lines + [
    "  ];",
    "}",
    "",
  ]

  write_block + read_block
}

// ── Map / Set helpers ────────────────────────────────────────────────
// Almide WASM layouts (see emit_wasm/calls_map.rs, calls_set.rs):
//   Map:  [len:i32][k0][v0][k1][v1]...
//   Set:  [len:i32][e0][e1]...
// Key/value widths = wasm_byte_size(ty). Keys are compared by Almide runtime
// with type-aware equality (i64_eq, i32_eq, string.eq), so the byte layout
// produced here must match what the runtime expects slot-for-slot.

// Is this type inline (stored directly in the slot) or pointer-shaped
// (4-byte i32 ptr into a separately-allocated payload)?
fn slot_is_inline(ty: Value) -> Bool = match get_kind(ty) {
  "int" => true, "float" => true, "bool" => true,
  _ => false,
}

// Write a single slot at the given address. For inline types emit direct
// store; for pointer-shaped types expect the caller to pre-compute the ptr
// in `src` (which is an expression evaluating to an i32 ptr).
fn slot_write_line(ty: Value, dst_off: String, src: String) -> String = match get_kind(ty) {
  "int"    => "view.setBigInt64(${dst_off}, BigInt(${src}), true);",
  "float"  => "view.setFloat64(${dst_off}, ${src}, true);",
  "bool"   => "view.setInt32(${dst_off}, ${src} ? 1 : 0, true);",
  _        => "view.setInt32(${dst_off}, ${src}, true);",
}

fn slot_read_line(ty: Value, src_off: String) -> String = match get_kind(ty) {
  "int"    => "Number(view.getBigInt64(${src_off}, true))",
  "float"  => "view.getFloat64(${src_off}, true)",
  "bool"   => "view.getInt32(${src_off}, true) !== 0",
  _        => from_wasm(ty, "view.getInt32(${src_off}, true)"),
}

// Legacy aliases kept for tuple emit (which only marshalls primitive / string
// slots directly without the pre-write pointer phase).
fn prim_write_line(ty: Value, dst_off: String, src: String) -> String = match get_kind(ty) {
  "int"    => "view.setBigInt64(${dst_off}, BigInt(${src}), true);",
  "float"  => "view.setFloat64(${dst_off}, ${src}, true);",
  "bool"   => "view.setInt32(${dst_off}, ${src} ? 1 : 0, true);",
  "string" => "view.setInt32(${dst_off}, _writeString(${src}), true);",
  _        => "/* unsupported prim write: ${get_kind(ty)} */",
}

fn prim_read_line(ty: Value, src_off: String) -> String = match get_kind(ty) {
  "int"    => "Number(view.getBigInt64(${src_off}, true))",
  "float"  => "view.getFloat64(${src_off}, true)",
  "bool"   => "view.getInt32(${src_off}, true) !== 0",
  "string" => "_readString(view.getInt32(${src_off}, true))",
  _        => "undefined /* unsupported prim read: ${get_kind(ty)} */",
}

// Emit map helpers, supporting inline primitive values AND pointer-shaped
// values (String / Named / List / Option / Matrix). Pointer-shaped values
// are written in a pre-allocation phase so their nested writes cannot detach
// the outer DataView via WASM memory grow.
fn emit_map_helpers(ty: Value) -> List[String] = {
  let k = json.get(ty, "key") ?? json.null()
  let v = json.get(ty, "value") ?? json.null()
  let sig = "${type_sig(k)}_${type_sig(v)}"
  let k_size = wasm_byte_size(k)
  let v_size = wasm_byte_size(v)
  let pair_size = k_size + v_size
  let k_off = "base"
  let v_off = "base + ${int.to_string(k_size)}"

  // Key pre-write: String keys need _writeString before the outer alloc.
  let key_pre_expr = match get_kind(k) {
    "string" => "_writeString(entries[i][0])",
    _        => "entries[i][0]",
  }
  let val_pre_expr = if slot_is_inline(v) then "entries[i][1]"
                     else to_wasm(v, "entries[i][1]")

  let write_k = slot_write_line(k, k_off, "_ks[i]")
  let write_v = slot_write_line(v, v_off, "_vs[i]")
  let read_k  = slot_read_line(k, k_off)
  let read_v  = slot_read_line(v, v_off)

  [
    "function _writeMap_${sig}(m) {",
    "  const entries = (m instanceof Map) ? Array.from(m.entries()) : Array.from(m);",
    "  const n = entries.length;",
    "  // Pre-compute all pointer-shaped slots BEFORE the outer alloc. Any alloc",
    "  // done by a nested write (e.g. _writeString) may grow WASM memory and",
    "  // detach previously-taken DataViews — safest to finish all sub-writes first.",
    "  const _ks = new Array(n);",
    "  const _vs = new Array(n);",
    "  for (let i = 0; i < n; i++) {",
    "    _ks[i] = ${key_pre_expr};",
    "    _vs[i] = ${val_pre_expr};",
    "  }",
    "  const pair = ${int.to_string(pair_size)};",
    "  const ptr = _exports.__alloc(4 + n * pair);",
    "  const view = new DataView(_exports.memory.buffer);",
    "  view.setInt32(ptr, n, true);",
    "  for (let i = 0; i < n; i++) {",
    "    const base = ptr + 4 + i * pair;",
    "    ${write_k}",
    "    ${write_v}",
    "  }",
    "  return ptr;",
    "}",
    "",
    "function _readMap_${sig}(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  const n = view.getInt32(ptr, true);",
    "  const pair = ${int.to_string(pair_size)};",
    "  const out = new Map();",
    "  for (let i = 0; i < n; i++) {",
    "    const base = ptr + 4 + i * pair;",
    "    out.set(${read_k}, ${read_v});",
    "  }",
    "  return out;",
    "}",
    "",
  ]
}

fn emit_set_helpers(ty: Value) -> List[String] = {
  let e = json.get(ty, "inner") ?? json.null()
  let sig = type_sig(e)
  let e_size = wasm_byte_size(e)
  let elem_pre_expr = match get_kind(e) {
    "string" => "_writeString(elems[i])",
    _ => if slot_is_inline(e) then "elems[i]" else to_wasm(e, "elems[i]"),
  }
  let write_e = slot_write_line(e, "ptr + 4 + i * elem", "_es[i]")
  let read_e  = slot_read_line(e, "ptr + 4 + i * elem")
  [
    "function _writeSet_${sig}(s) {",
    "  const elems = (s instanceof Set) ? Array.from(s) : Array.from(s);",
    "  const n = elems.length;",
    "  // Pre-write pointer-shaped elements before outer alloc (see _writeMap_*).",
    "  const _es = new Array(n);",
    "  for (let i = 0; i < n; i++) _es[i] = ${elem_pre_expr};",
    "  const elem = ${int.to_string(e_size)};",
    "  const ptr = _exports.__alloc(4 + n * elem);",
    "  const view = new DataView(_exports.memory.buffer);",
    "  view.setInt32(ptr, n, true);",
    "  for (let i = 0; i < n; i++) {",
    "    ${write_e}",
    "  }",
    "  return ptr;",
    "}",
    "",
    "function _readSet_${sig}(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  const n = view.getInt32(ptr, true);",
    "  const elem = ${int.to_string(e_size)};",
    "  const out = new Set();",
    "  for (let i = 0; i < n; i++) {",
    "    out.add(${read_e});",
    "  }",
    "  return out;",
    "}",
    "",
  ]
}

// Collect all distinct map/set signatures used by supported fns.
fn collect_maps_in_ty(ty: Value) -> List[Value] = match get_kind(ty) {
  "map"    => [ty],
  "list"   => collect_maps_in_ty(json.get(ty, "inner") ?? json.null()),
  "option" => collect_maps_in_ty(json.get(ty, "inner") ?? json.null()),
  "result" => {
    let a = collect_maps_in_ty(json.get(ty, "ok") ?? json.null())
    let b = collect_maps_in_ty(json.get(ty, "err") ?? json.null())
    a + b
  },
  _ => [],
}

fn collect_sets_in_ty(ty: Value) -> List[Value] = match get_kind(ty) {
  "set"    => [ty],
  "list"   => collect_sets_in_ty(json.get(ty, "inner") ?? json.null()),
  "option" => collect_sets_in_ty(json.get(ty, "inner") ?? json.null()),
  "result" => {
    let a = collect_sets_in_ty(json.get(ty, "ok") ?? json.null())
    let b = collect_sets_in_ty(json.get(ty, "err") ?? json.null())
    a + b
  },
  _ => [],
}

fn collect_maps_in_fn(fn_val: Value) -> List[Value] = {
  let params = get_arr(fn_val, "params")
  let pm = params |> list.flat_map((p) => collect_maps_in_ty(get_type(p)))
  pm + collect_maps_in_ty(effective_return(fn_val))
}

fn collect_sets_in_fn(fn_val: Value) -> List[Value] = {
  let params = get_arr(fn_val, "params")
  let ps = params |> list.flat_map((p) => collect_sets_in_ty(get_type(p)))
  ps + collect_sets_in_ty(effective_return(fn_val))
}

// Emit a TS interface declaration for a record type.
fn emit_record_interface(type_def: Value) -> List[String] = {
  let name = get_str(type_def, "name")
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  let fields = get_arr(kind_rec, "fields")
  let field_lines = fields |> list.map((f) =>
    "  ${get_str(f, "name")}: ${ts_type(get_type(f))};"
  )
  ["export interface ${name} {"] + field_lines + ["}", ""]
}

// ── Public API (stubs — full impl in subsequent iterations) ──

fn version() -> String = "0.1.0"

// ── WIT (WebAssembly Interface Type) generation ──
//
// WIT is the interface language for Component Model. Even though
// `almide build --target wasm` today emits a core module (not a component),
// emitting a .wit file lets downstream tools (jco, wasmtime componentize,
// wit-bindgen) treat the Almide module as if it were a component.
//
// This is the on-ramp to P3-1 Component Model output: once Almide produces
// a real `.wasm` component, the generated `.wit` already describes it.

fn wit_type(ty: Value) -> String = match get_kind(ty) {
  "int"    => "s64",
  "float"  => "f64",
  "bool"   => "bool",
  "string" => "string",
  "unit"   => "",
  "list"   => "list<${wit_type(json.get(ty, "inner") ?? json.null())}>",
  "option" => "option<${wit_type(json.get(ty, "inner") ?? json.null())}>",
  "result" => {
    let ok_t = wit_type(json.get(ty, "ok") ?? json.null())
    let err_t = wit_type(json.get(ty, "err") ?? json.null())
    if ok_t == "" then "result<_, ${err_t}>"
    else "result<${ok_t}, ${err_t}>"
  },
  "named"  => wit_ident(get_str(ty, "name")),
  // Matrix has no WIT-native representation. We model it as a record with
  // {rows, cols, data} so downstream Component Model hosts see a flat shape.
  "matrix" => "matrix",
  _        => "unknown-type",
}

// Convert a CamelCase / snake_case Almide name to kebab-case for WIT.
fn wit_ident(name: String) -> String = string.to_lower(
  string.chars(name)
    |> list.enumerate
    |> list.map((entry) => {
      let (i, c) = entry
      if i == 0 then c
      else if c == string.to_upper(c) and c != string.to_lower(c) then "-${c}"
      else if c == "_" then "-"
      else c
    })
    |> list.join("")
)

// Emit a WIT `record` declaration for a record type.
fn wit_emit_record(type_def: Value) -> List[String] = {
  let name = wit_ident(get_str(type_def, "name"))
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  let fields = get_arr(kind_rec, "fields")
  let field_lines = fields |> list.map((f) =>
    "    ${wit_ident(get_str(f, "name"))}: ${wit_type(get_type(f))},"
  )
  ["  record ${name} {"] + field_lines + ["  }", ""]
}

// Emit a WIT `variant` declaration.
fn wit_emit_variant(type_def: Value) -> List[String] = {
  let name = wit_ident(get_str(type_def, "name"))
  let kind_rec = json.get(type_def, "kind") ?? json.null()
  let cases = get_arr(kind_rec, "cases")
  let case_lines = cases |> list.map((c) => {
    let cname = wit_ident(get_str(c, "name"))
    let fields = variant_case_fields(c)
    if list.is_empty(fields) then "    ${cname},"
    else if list.len(fields) == 1 then "    ${cname}(${wit_type(list.get(fields, 0) ?? json.null())}),"
    else {
      let inner = fields |> list.map((f) => wit_type(f)) |> list.join(", ")
      "    ${cname}(tuple<${inner}>),"
    }
  })
  ["  variant ${name} {"] + case_lines + ["  }", ""]
}

// Emit a WIT function signature.
fn wit_emit_fn(fn_val: Value) -> String = {
  let name = wit_ident(get_str(fn_val, "name"))
  let params = get_arr(fn_val, "params")
  let ret_ty = effective_return(fn_val)
  let params_str = params
    |> list.map((p) => "${wit_ident(get_str(p, "name"))}: ${wit_type(get_type(p))}")
    |> list.join(", ")
  let ret_part = if get_kind(ret_ty) == "unit" then "" else " -> ${wit_type(ret_ty)}"
  "  ${name}: func(${params_str})${ret_part};"
}

fn generate_wit(iface_json: String, module_name: String) -> String = {
  let iface = json.parse(iface_json) ?? json.null()
  let types = get_arr(iface, "types")
  let fns = get_arr(iface, "functions")
  let supported = fns |> list.filter((f) => is_supported_fn(f))

  let used_direct = supported |> list.flat_map((f) => collect_named_in_fn(f))
  let used_names = expand_named_deps(used_direct, types)

  let type_blocks = types
    |> list.filter((t) => list.contains(used_names, get_str(t, "name")))
    |> list.flat_map((t) => {
      if record_supported(t) then wit_emit_record(t)
      else if variant_supported(t) then wit_emit_variant(t)
      else []
    })

  let fn_export_lines = supported |> list.map((f) => "  export " + string.trim(wit_emit_fn(f)))
  let iface_name = wit_ident(module_name)
  // Functions are exported directly at the world level (not wrapped in an
  // interface) so the underlying core module's plain exports — `greet`,
  // `add`, etc. — match the component contract without namespacing.
  let header = [
    "// Generated by almide-wasm-bindgen. Do not edit.",
    "package almide:${iface_name}@0.1.0;",
    "",
    "world ${iface_name} {",
  ]
  let footer = ["}", ""]
  (header + type_blocks + fn_export_lines + footer) |> list.join("\n")
}

fn generate_esm(iface_json: String, module_name: String) -> String = {
  let iface = json.parse(iface_json) ?? json.null()
  let types = get_arr(iface, "types")
  let fns = get_arr(iface, "functions")
  // Exports (things the user calls) vs imports (things WASM calls back to JS).
  // `import` field on a fn marks it as a @extern(wasm, "mod", "name") target.
  let is_import = (f: Value) => (json.get(f, "import") ?? json.null()) != json.null()
  let supported = fns |> list.filter((f) => not is_import(f) and is_supported_fn(f))
  let js_imports = fns |> list.filter((f) => is_import(f))

  // Per-type record helpers injected after string/list/option/result helpers.
  // Filter to only those types referenced by supported fns (same as dts).
  let used_direct = supported |> list.flat_map((f) => collect_named_in_fn(f))
  let used_names = expand_named_deps(used_direct, types)
  let record_helpers = types
    |> list.filter((t) => list.contains(used_names, get_str(t, "name")))
    |> list.flat_map((t) => {
      if record_supported(t) then emit_record_helpers(t)
      else if variant_supported(t) then emit_variant_helpers(t)
      else []
    })

  // Tuple helpers: one _writeTuple_<sig> / _readTuple_<sig> per distinct
  // tuple shape referenced by any supported fn.
  let all_tuples = supported |> list.flat_map((f) => collect_tuples_in_fn(f))
  let tuple_helpers = {
    let (acc, _) = all_tuples |> list.fold(([], []), (state, ty) => {
      let (lines, seen) = state
      let sig = tuple_sig(ty)
      if list.contains(seen, sig) then (lines, seen)
      else (lines + emit_tuple_helpers(ty), seen + [sig])
    })
    acc
  }

  // Bytes helpers — fixed shape (Uint8Array), emit once when referenced.
  // Layout matches emit_wasm/calls_bytes.rs: [len:i32][data:u8...], identical
  // to String but opaque (no UTF-8 decode, raw bytes).
  let ty_uses_bytes = (ty: Value) => bytes_appears_in(ty)
  let fn_uses_bytes = (f: Value) => {
    let params = get_arr(f, "params")
    let any_p = params |> list.fold(false, (acc, p) => acc or ty_uses_bytes(get_type(p)))
    any_p or ty_uses_bytes(effective_return(f))
  }
  let uses_bytes = supported |> list.fold(false, (acc, f) => acc or fn_uses_bytes(f))
  let bytes_helpers = if uses_bytes then [
    "// --- Bytes marshalling (opaque Uint8Array) ---------------------------",
    "// Layout: [len:i32 LE][data:u8...]  (matches String; no UTF-8 decode).",
    "function _writeBytes(arr) {",
    "  // Accepts Uint8Array or number[] (Array.from used as fallback).",
    "  const src = (arr instanceof Uint8Array) ? arr : Uint8Array.from(arr);",
    "  const n = src.length;",
    "  const ptr = _exports.__alloc(4 + n);",
    "  const view = new DataView(_exports.memory.buffer);",
    "  view.setInt32(ptr, n, true);",
    "  new Uint8Array(_exports.memory.buffer, ptr + 4, n).set(src);",
    "  return ptr;",
    "}",
    "",
    "function _readBytes(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  const n = view.getInt32(ptr, true);",
    "  // .slice() copies out so the returned buffer survives WASM memory grow.",
    "  return new Uint8Array(_exports.memory.buffer, ptr + 4, n).slice();",
    "}",
    "",
  ] else []

  // Map / Set helpers — same per-shape dedup pattern.
  let all_maps = supported |> list.flat_map((f) => collect_maps_in_fn(f))
  let map_helpers = {
    let (acc, _) = all_maps |> list.fold(([], []), (state, ty) => {
      let (lines, seen) = state
      let k = json.get(ty, "key") ?? json.null()
      let v = json.get(ty, "value") ?? json.null()
      let sig = "${type_sig(k)}_${type_sig(v)}"
      if list.contains(seen, sig) then (lines, seen)
      else (lines + emit_map_helpers(ty), seen + [sig])
    })
    acc
  }
  let all_sets = supported |> list.flat_map((f) => collect_sets_in_fn(f))
  let set_helpers = {
    let (acc, _) = all_sets |> list.fold(([], []), (state, ty) => {
      let (lines, seen) = state
      let e = json.get(ty, "inner") ?? json.null()
      let sig = type_sig(e)
      if list.contains(seen, sig) then (lines, seen)
      else (lines + emit_set_helpers(ty), seen + [sig])
    })
    acc
  }

  // Matrix helpers — emit only when any supported fn uses Matrix.
  let uses_matrix = supported |> list.fold(false, (acc, f) => acc or fn_uses_matrix(f))
  let matrix_helpers = if uses_matrix then [
    "// --- Matrix marshalling (f64, row-major) -----------------------------",
    "// Layout: [rows:i32 LE][cols:i32 LE][data: f64 LE * rows * cols]",
    "//",
    "// Matrix is a *persistent handle* class: instances hold a raw pointer",
    "// into WASM linear memory, not a copy. Chained ops (scale → add → ...)",
    "// pass handles around without re-serialising, so the JS↔WASM boundary",
    "// cost is paid once on input, once on materialisation — not per-op.",
    "//",
    "// Accepts as input EITHER a Matrix instance (zero-copy, fast path) OR a",
    "// plain `{rows, cols, data}` object (copies into WASM, for user-built",
    "// inputs from Float64Array / number[]).",
    "export class Matrix {",
    "  constructor(ptr, rows, cols) {",
    "    this._ptr = ptr | 0;",
    "    this.rows = rows | 0;",
    "    this.cols = cols | 0;",
    "  }",
    "  /** Zero-copy Float64Array view over WASM memory. Invalidated by any",
    "   *  subsequent alloc that grows memory, or by __heapRestore. For long-",
    "   *  lived data, call .toFloat64Array() (copy). */",
    "  get data() {",
    "    return new Float64Array(_exports.memory.buffer, this._ptr + 8, this.rows * this.cols);",
    "  }",
    "  /** Detached copy — safe across grow / restore. */",
    "  toFloat64Array() { return this.data.slice(); }",
    "  /** Same shape as the plain-object Matrix for interop: {rows, cols, data}. */",
    "  toJSON() { return { rows: this.rows, cols: this.cols, data: this.toFloat64Array() }; }",
    "}",
    "",
    "function _writeMatrix(m) {",
    "  // Fast path: Matrix handle already lives in WASM memory. Reuse its ptr.",
    "  if (m instanceof Matrix) return m._ptr;",
    "  const rows = m.rows | 0;",
    "  const cols = m.cols | 0;",
    "  const n = rows * cols;",
    "  // Detach the input from WASM memory BEFORE the alloc. If the caller",
    "  // passed in a Float64Array view over WASM linear memory, the upcoming",
    "  // __alloc may grow memory and detach that view — leaving us with no",
    "  // way to read the source. Float64Array.slice() always returns a fresh",
    "  // standalone TypedArray.",
    "  const data = m.data;",
    "  const src = (data instanceof Float64Array)",
    "    ? data.slice()",
    "    : Float64Array.from(data);",
    "  const ptr = _exports.__alloc(8 + n * 8);",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  view.setInt32(ptr, rows, true);",
    "  view.setInt32(ptr + 4, cols, true);",
    "  new Float64Array(buf, ptr + 8, n).set(src);",
    "  return ptr;",
    "}",
    "",
    "function _readMatrix(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  const rows = view.getInt32(ptr, true);",
    "  const cols = view.getInt32(ptr + 4, true);",
    "  return new Matrix(ptr, rows, cols);",
    "}",
    "",
  ] else []

  // Static preamble: init() + WASI shim + string marshalling helpers.
  // Module-name interpolation only lands in the URL line.
  let preamble = [
    "// Generated by almide-wasm-bindgen. Do not edit.",
    "",
    "let _exports = null;",
    "",
    "export default async function init(wasmUrl, jsImports = {}) {",
    "  const url = wasmUrl ?? new URL('./${module_name}.wasm', import.meta.url);",
    "  // Minimal WASI shim: fd_write routes stdout/stderr through console,",
    "  // other syscalls are no-ops. Enough for println/print-style output.",
    "  const _decoder = new TextDecoder('utf-8');",
    "  const wasi = new Proxy({}, {",
    "    get(_t, name) {",
    "      if (name === 'proc_exit') return () => {};",
    "      if (name === 'fd_prestat_get') return () => 8;  // BADF",
    "      if (name === 'fd_write') return (fd, iovs_ptr, iovs_len, nwritten_ptr) => {",
    "        const mem = new DataView(_exports.memory.buffer);",
    "        const bytes = new Uint8Array(_exports.memory.buffer);",
    "        let total = 0;",
    "        const chunks = [];",
    "        for (let i = 0; i < iovs_len; i++) {",
    "          const base = iovs_ptr + i * 8;",
    "          const ptr = mem.getInt32(base, true);",
    "          const len = mem.getInt32(base + 4, true);",
    "          chunks.push(bytes.slice(ptr, ptr + len));",
    "          total += len;",
    "        }",
    "        const combined = new Uint8Array(total);",
    "        let off = 0;",
    "        for (const c of chunks) { combined.set(c, off); off += c.length; }",
    "        const text = _decoder.decode(combined);",
    "        const hasNode = typeof process !== 'undefined' && process.stdout && process.stderr;",
    "        if (fd === 2) {",
    "          if (hasNode) process.stderr.write(text); else console.error(text);",
    "        } else {",
    "          if (hasNode) process.stdout.write(text); else console.log(text);",
    "        }",
    "        mem.setInt32(nwritten_ptr, total, true);",
    "        return 0;",
    "      };",
    "      return () => 0;",
    "    },",
    "  });",
    "  const imports = { wasi_snapshot_preview1: wasi, ..._buildJsImports(jsImports) };",
    "  const isNode = typeof process !== 'undefined' && process.versions?.node;",
    "  const urlStr = url.toString();",
    "  const wasmBytes = (isNode && urlStr.startsWith('file:'))",
    "    ? await (await import('node:fs/promises')).readFile(new URL(urlStr))",
    "    : await (await fetch(url)).arrayBuffer();",
    "  const mod = await WebAssembly.instantiate(await wasmBytes, imports);",
    "  _exports = mod.instance.exports;",
    "  if (typeof _exports._start === 'function') {",
    "    try { _exports._start(); } catch (e) {}",
    "  }",
    "}",
    "",
    "// --- Arena cleanup (manual scope) -------------------------------------",
    "// Almide's __alloc is bump-only — the heap pointer never goes back on its",
    "// own. For long loops you can checkpoint the heap and rewind it:",
    "//",
    "//   const ck = __heapSave();",
    "//   for (let i = 0; i < 1000; i++) {",
    "//     useResultImmediately(myFn(...));",
    "//     __heapRestore(ck);  // free everything since checkpoint",
    "//   }",
    "//",
    "// IMPORTANT: any Float64Array view returned by Matrix-typed fns is",
    "// invalidated by __heapRestore. Copy with `.slice()` if you need it",
    "// to survive the rewind.",
    "export function __heapSave() { return _exports.__heap_save(); }",
    "export function __heapRestore(ck) { _exports.__heap_restore(ck); }",
    "",
    "// --- String marshalling ------------------------------------------------",
    "// Almide string layout: [len:i32 LE][data:u8 * len]. Pointer is the head.",
    "const _td = new TextDecoder('utf-8');",
    "const _te = new TextEncoder();",
    "",
    "function _writeString(s) {",
    "  const bytes = _te.encode(s);",
    "  const len = bytes.length;",
    "  const ptr = _exports.__alloc(4 + len);",
    "  const buf = _exports.memory.buffer;",
    "  new DataView(buf).setInt32(ptr, len, true);",
    "  new Uint8Array(buf, ptr + 4, len).set(bytes);",
    "  return ptr;",
    "}",
    "",
    "function _readString(ptr) {",
    "  const buf = _exports.memory.buffer;",
    "  const len = new DataView(buf).getInt32(ptr, true);",
    "  return _td.decode(new Uint8Array(buf, ptr + 4, len));",
    "}",
    "",
    "// --- List[Int] marshalling ---------------------------------------------",
    "// Almide list layout: [len:i32 LE][i64 LE * len]. 8-byte elements for Int.",
    "// BigInt/Number conversion loses precision above 2^53 — document for callers.",
    "function _writeListInt(arr) {",
    "  const len = arr.length;",
    "  const ptr = _exports.__alloc(4 + len * 8);",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  view.setInt32(ptr, len, true);",
    "  for (let i = 0; i < len; i++) {",
    "    view.setBigInt64(ptr + 4 + i * 8, BigInt(arr[i]), true);",
    "  }",
    "  return ptr;",
    "}",
    "",
    "function _readListInt(ptr) {",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  const len = view.getInt32(ptr, true);",
    "  const out = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    out[i] = Number(view.getBigInt64(ptr + 4 + i * 8, true));",
    "  }",
    "  return out;",
    "}",
    "",
    "// --- List[Float] marshalling (8-byte f64 LE elements) -----------------",
    "function _writeListFloat(arr) {",
    "  const len = arr.length;",
    "  const ptr = _exports.__alloc(4 + len * 8);",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  view.setInt32(ptr, len, true);",
    "  for (let i = 0; i < len; i++) {",
    "    view.setFloat64(ptr + 4 + i * 8, arr[i], true);",
    "  }",
    "  return ptr;",
    "}",
    "",
    "function _readListFloat(ptr) {",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  const len = view.getInt32(ptr, true);",
    "  const out = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    out[i] = view.getFloat64(ptr + 4 + i * 8, true);",
    "  }",
    "  return out;",
    "}",
    "",
    "// --- List[Bool] marshalling (4-byte i32 LE, 0/1) ----------------------",
    "function _writeListBool(arr) {",
    "  const len = arr.length;",
    "  const ptr = _exports.__alloc(4 + len * 4);",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  view.setInt32(ptr, len, true);",
    "  for (let i = 0; i < len; i++) {",
    "    view.setInt32(ptr + 4 + i * 4, arr[i] ? 1 : 0, true);",
    "  }",
    "  return ptr;",
    "}",
    "",
    "function _readListBool(ptr) {",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  const len = view.getInt32(ptr, true);",
    "  const out = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    out[i] = view.getInt32(ptr + 4 + i * 4, true) !== 0;",
    "  }",
    "  return out;",
    "}",
    "",
    "// --- List[String] marshalling (4-byte i32 ptrs to [len][utf8]) --------",
    "// Each element is itself a string pointer, written via _writeString and",
    "// read via _readString. Memory grown by _writeString during the loop is",
    "// re-read from _exports.memory.buffer each iteration, so ptr stays valid.",
    "function _writeListString(arr) {",
    "  const len = arr.length;",
    "  const elem_ptrs = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    elem_ptrs[i] = _writeString(arr[i]);",
    "  }",
    "  const ptr = _exports.__alloc(4 + len * 4);",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  view.setInt32(ptr, len, true);",
    "  for (let i = 0; i < len; i++) {",
    "    view.setInt32(ptr + 4 + i * 4, elem_ptrs[i], true);",
    "  }",
    "  return ptr;",
    "}",
    "",
    "function _readListString(ptr) {",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  const len = view.getInt32(ptr, true);",
    "  const elem_ptrs = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    elem_ptrs[i] = view.getInt32(ptr + 4 + i * 4, true);",
    "  }",
    "  const out = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    out[i] = _readString(elem_ptrs[i]);",
    "  }",
    "  return out;",
    "}",
    "",
    "// --- Generic pointer-list helpers -------------------------------------",
    "// For List[Option[T]] / List[Record] / List[List[_]] — elements are i32",
    "// pointers and per-element marshalling is supplied by the caller.",
    "// All element writes happen before the outer __alloc so memory grow does",
    "// not invalidate in-flight pointers.",
    "function _writeListPtr(arr, writeElem) {",
    "  const len = arr.length;",
    "  const elem_ptrs = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    elem_ptrs[i] = writeElem(arr[i]);",
    "  }",
    "  const ptr = _exports.__alloc(4 + len * 4);",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  view.setInt32(ptr, len, true);",
    "  for (let i = 0; i < len; i++) {",
    "    view.setInt32(ptr + 4 + i * 4, elem_ptrs[i], true);",
    "  }",
    "  return ptr;",
    "}",
    "",
    "function _readListPtr(ptr, readElem) {",
    "  const buf = _exports.memory.buffer;",
    "  const view = new DataView(buf);",
    "  const len = view.getInt32(ptr, true);",
    "  const elem_ptrs = new Array(len);",
    "  for (let i = 0; i < len; i++) {",
    "    elem_ptrs[i] = view.getInt32(ptr + 4 + i * 4, true);",
    "  }",
    "  return elem_ptrs.map(readElem);",
    "}",
    "",
    "// --- Option[T] marshalling ---------------------------------------------",
    "// Almide ABI: 0 = None, otherwise ptr → [value] inline (no tag).",
    "// JS surface: null | T.",
    "function _writeOptionInt(v) {",
    "  if (v === null || v === undefined) return 0;",
    "  const ptr = _exports.__alloc(8);",
    "  new DataView(_exports.memory.buffer).setBigInt64(ptr, BigInt(v), true);",
    "  return ptr;",
    "}",
    "function _readOptionInt(ptr) {",
    "  if (ptr === 0) return null;",
    "  return Number(new DataView(_exports.memory.buffer).getBigInt64(ptr, true));",
    "}",
    "",
    "function _writeOptionFloat(v) {",
    "  if (v === null || v === undefined) return 0;",
    "  const ptr = _exports.__alloc(8);",
    "  new DataView(_exports.memory.buffer).setFloat64(ptr, v, true);",
    "  return ptr;",
    "}",
    "function _readOptionFloat(ptr) {",
    "  if (ptr === 0) return null;",
    "  return new DataView(_exports.memory.buffer).getFloat64(ptr, true);",
    "}",
    "",
    "function _writeOptionBool(v) {",
    "  if (v === null || v === undefined) return 0;",
    "  const ptr = _exports.__alloc(4);",
    "  new DataView(_exports.memory.buffer).setInt32(ptr, v ? 1 : 0, true);",
    "  return ptr;",
    "}",
    "function _readOptionBool(ptr) {",
    "  if (ptr === 0) return null;",
    "  return new DataView(_exports.memory.buffer).getInt32(ptr, true) !== 0;",
    "}",
    "",
    "function _writeOptionString(v) {",
    "  if (v === null || v === undefined) return 0;",
    "  const sptr = _writeString(v);",
    "  const ptr = _exports.__alloc(4);",
    "  new DataView(_exports.memory.buffer).setInt32(ptr, sptr, true);",
    "  return ptr;",
    "}",
    "function _readOptionString(ptr) {",
    "  if (ptr === 0) return null;",
    "  const sptr = new DataView(_exports.memory.buffer).getInt32(ptr, true);",
    "  return _readString(sptr);",
    "}",
    "",
    "// --- Result[T, String] marshalling -------------------------------------",
    "// Almide ABI: ptr → [tag:i32 (0=ok, 1=err)][value]. Value stored at offset 4.",
    "// JS surface: Ok(v) returns v directly, Err(e) throws new Error(e).",
    "function _readResultIntString(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  if (view.getInt32(ptr, true) === 0) {",
    "    return Number(view.getBigInt64(ptr + 4, true));",
    "  }",
    "  throw new Error(_readString(view.getInt32(ptr + 4, true)));",
    "}",
    "",
    "function _readResultFloatString(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  if (view.getInt32(ptr, true) === 0) {",
    "    return view.getFloat64(ptr + 4, true);",
    "  }",
    "  throw new Error(_readString(view.getInt32(ptr + 4, true)));",
    "}",
    "",
    "function _readResultBoolString(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  if (view.getInt32(ptr, true) === 0) {",
    "    return view.getInt32(ptr + 4, true) !== 0;",
    "  }",
    "  throw new Error(_readString(view.getInt32(ptr + 4, true)));",
    "}",
    "",
    "function _readResultStringString(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  if (view.getInt32(ptr, true) === 0) {",
    "    return _readString(view.getInt32(ptr + 4, true));",
    "  }",
    "  throw new Error(_readString(view.getInt32(ptr + 4, true)));",
    "}",
    "",
    "function _readResultUnitString(ptr) {",
    "  const view = new DataView(_exports.memory.buffer);",
    "  if (view.getInt32(ptr, true) === 0) {",
    "    return undefined;",
    "  }",
    "  throw new Error(_readString(view.getInt32(ptr + 4, true)));",
    "}",
    "",
  ]

  let fn_blocks = supported |> list.flat_map((f) => {
    let name = get_str(f, "name")
    let params = get_arr(f, "params")
    let ret = effective_return(f)
    let js_params = params |> list.map((p) => get_str(p, "name")) |> list.join(", ")
    let wasm_args = params
      |> list.map((p) => to_wasm(get_type(p), get_str(p, "name")))
      |> list.filter((s) => s != "")
      |> list.join(", ")
    let call = "_exports.${name}(${wasm_args})"
    let body = if get_kind(ret) == "unit" then "${call}; return;"
               else "return ${from_wasm(ret, call)};"
    [
      "export function ${name}(${js_params}) {",
      "  if (!_exports) throw new Error('almide-wasm-bindgen: call init() before ${name}()');",
      "  ${body}",
      "}",
      "",
    ]
  })

  // --- JS import shim emission ----------------------------------------
  // For each @extern(wasm, "module", "name") fn, emit a wrapped dispatcher
  // that: (a) pulls the user-supplied callback from jsImports[module][name],
  // (b) marshals WASM→JS for each param (from_wasm), (c) invokes the
  // callback, (d) marshals JS→WASM for the return value (to_wasm), and
  // (e) throws a helpful error when the host forgot to supply the callback.
  //
  // Only primitive import types (Int/Float/Bool/Unit) are supported in this
  // iter. Pointer-shaped imports (String/List/Record) would need lifetime
  // handling around the call — deferred.
  let import_shim = if list.len(js_imports) == 0 then [] else {
    let header = [
      "// --- JS import shim ----------------------------------------------------",
      "// The Almide module declares (import \"mod\" \"name\" ...) for every fn",
      "// annotated with @extern(wasm, \"mod\", \"name\"). The host supplies the",
      "// implementations via the jsImports arg to init():",
      "//",
      "//   await init(undefined, { js: { console_log_i64: (x) => console.log(x) } })",
      "",
      "function _buildJsImports(user) {",
      "  const out = {};",
    ]
    let per_import = js_imports |> list.flat_map((f) => {
      let imp = json.get(f, "import") ?? json.null()
      let mod_name = get_str(imp, "module")
      let fn_name = get_str(imp, "name")
      let params = get_arr(f, "params")
      let ret = effective_return(f)
      let param_names = params |> list.enumerate |> list.map((entry) => {
        let (i, _) = entry
        "a${int.to_string(i)}"
      }) |> list.join(", ")
      let js_args = params |> list.enumerate |> list.map((entry) => {
        let (i, p) = entry
        from_wasm(get_type(p), "a${int.to_string(i)}")
      }) |> list.join(", ")
      let raw_call = "cb(${js_args})"
      let call_body = if get_kind(ret) == "unit" then "${raw_call};"
                      else "return ${to_wasm(ret, raw_call)};"
      let err_msg = "almide-wasm-bindgen: missing import '${mod_name}.${fn_name}' — supply it via init(url, { ${mod_name}: { ${fn_name}: (...) => ... } })"
      [
        "  if (!out[\"${mod_name}\"]) out[\"${mod_name}\"] = {};",
        "  out[\"${mod_name}\"][\"${fn_name}\"] = (${param_names}) => {",
        "    const cb = user?.[\"${mod_name}\"]?.[\"${fn_name}\"];",
        "    if (typeof cb !== \"function\") {",
        "      throw new Error(\"${err_msg}\");",
        "    }",
        "    ${call_body}",
        "  };",
      ]
    })
    let footer = [
      "  return out;",
      "}",
      "",
    ]
    header + per_import + footer
  }

  // Early init() fall-back: when the module has no @extern(wasm,...) imports,
  // _buildJsImports is referenced but never defined. Add a no-op so the same
  // init() preamble template stays valid for both cases.
  let shim_noop = if list.len(js_imports) == 0 then [
    "function _buildJsImports(_user) { return {}; }",
    "",
  ] else []

  (preamble + shim_noop + import_shim + matrix_helpers + bytes_helpers + record_helpers + tuple_helpers + map_helpers + set_helpers + fn_blocks) |> list.join("\n")
}

fn generate_dts(iface_json: String, module_name: String) -> String = {
  let iface = json.parse(iface_json) ?? json.null()
  let types = get_arr(iface, "types")
  let fns = get_arr(iface, "functions")
  let supported = fns |> list.filter((f) => is_supported_fn(f))

  // Only emit interfaces for types that are actually referenced by the
  // user's exported functions. This keeps stdlib records (FileStat,
  // ProcessStatus, ...) out of the generated .d.ts.
  let used_direct = supported |> list.flat_map((f) => collect_named_in_fn(f))
  let used_names = expand_named_deps(used_direct, types)
  let iface_blocks = types
    |> list.filter((t) => list.contains(used_names, get_str(t, "name")))
    |> list.flat_map((t) => {
      if record_supported(t) then emit_record_interface(t)
      else if variant_supported(t) then emit_variant_type(t)
      else []
    })

  // Matrix: prepend the Matrix handle class if any supported fn uses it.
  let uses_matrix = supported |> list.fold(false, (acc, f) => acc or fn_uses_matrix(f))
  let matrix_iface_block = if uses_matrix then [
    "/** Persistent handle into WASM memory for a row-major f64 matrix.",
    " *",
    " *  Chainable: values returned by matrix-producing fns are Matrix instances,",
    " *  and passing a Matrix back into another fn reuses the ptr (zero copy).",
    " *  Input fns also accept plain `{rows, cols, data}` (data: Float64Array",
    " *  | number[]) for one-shot user-built matrices.",
    " */",
    "export class Matrix {",
    "  readonly _ptr: number;",
    "  readonly rows: number;",
    "  readonly cols: number;",
    "  constructor(ptr: number, rows: number, cols: number);",
    "  /** Zero-copy Float64Array view over WASM memory. Invalidated by any",
    "   *  subsequent alloc that grows memory, or by __heapRestore. */",
    "  readonly data: Float64Array;",
    "  /** Detached copy — safe across grow / restore. */",
    "  toFloat64Array(): Float64Array;",
    "  /** Plain-object interop: {rows, cols, data: Float64Array}. */",
    "  toJSON(): { rows: number; cols: number; data: Float64Array };",
    "}",
    "",
    "/** Input shape for Matrix-accepting fns (either a Matrix handle or a",
    " *  plain object with raw data). */",
    "export type MatrixInput = Matrix | { rows: number; cols: number; data: Float64Array | number[] };",
    "",
  ] else []

  let sigs = supported |> list.flat_map((f) => {
    let name = get_str(f, "name")
    let params = get_arr(f, "params")
    let ret = effective_return(f)
    // Params accept MatrixInput (Matrix | {rows,cols,data}); returns use
    // the tight Matrix class. Done by a light string substitution so every
    // other ts_type mapping stays identical in both positions.
    let param_ty = (p: Value) => {
      let base = ts_type(get_type(p))
      if base == "Matrix" then "MatrixInput" else base
    }
    let params_str = params
      |> list.map((p) => "${get_str(p, "name")}: ${param_ty(p)}")
      |> list.join(", ")
    let almide_sig = almide_fn_signature(f)
    let is_effect = json.as_bool(json.get(f, "effect") ?? json.from_bool(false)) ?? false
    let throws_line = if is_effect then [" * @throws if the effect fn returned an error (Result.Err)."] else []
    let jsdoc = [
      "/**",
      " * Almide signature: `${almide_sig}`",
    ] + throws_line + [
      " */",
    ]
    jsdoc + ["export function ${name}(${params_str}): ${ts_type(ret)};"]
  })

  let header_lines = [
    "// Generated by almide-wasm-bindgen. Do not edit.",
    "",
    "export default function init(wasmUrl?: string | URL | Request): Promise<void>;",
    "",
    "/** Save the current Almide heap pointer. Pair with __heapRestore for",
    " *  arena-style cleanup of bump-allocated WASM memory. */",
    "export function __heapSave(): number;",
    "/** Reset the Almide heap pointer to a checkpoint from __heapSave.",
    " *  Pointers / Matrix views allocated above the checkpoint become",
    " *  invalid — call .slice() on any Float64Array data first. */",
    "export function __heapRestore(checkpoint: number): void;",
    "",
  ]
  let parts = header_lines + matrix_iface_block + iface_blocks + sigs
  (parts |> list.join("\n")) + "\n"
}

fn generate_package_json(module_name: String, version: String) -> String = {
  // Minimal npm package.json for a wasm-bindgen-style Almide module.
  // Includes:
  //   - sideEffects: false → bundlers (webpack/Vite/esbuild) can tree-shake
  //     dead Almide exports out of the consumer bundle
  //   - engines.node ≥18 → require global fetch / BigInt support
  //   - keywords for npm search visibility
  let v = if version == "" then "0.1.0" else version
  [
    "{",
    "  \"name\": \"${module_name}\",",
    "  \"version\": \"${v}\",",
    "  \"type\": \"module\",",
    "  \"main\": \"${module_name}.js\",",
    "  \"types\": \"${module_name}.d.ts\",",
    "  \"sideEffects\": false,",
    "  \"engines\": { \"node\": \">=18\" },",
    "  \"keywords\": [\"wasm\", \"webassembly\", \"almide\"],",
    "  \"files\": [\"${module_name}.js\", \"${module_name}.d.ts\", \"${module_name}.wasm\", \"${module_name}.wit\"]",
    "}",
    "",
  ] |> list.join("\n")
}
